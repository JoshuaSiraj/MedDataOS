# Sent as the model name on each question. The example agent ignores this
# and calls OPENAI_MODEL instead.
AGENT_MODEL=example
AGENT_API_KEY=
AGENT_TIMEOUT=120

# The model the example agent forwards each question to.
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Server configuration
HOST=127.0.0.1
PORT=8080
