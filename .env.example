# Sent as the model name on each question. The example agent ignores this
# and calls OPENAI_MODEL instead.
AGENT_MODEL=example
AGENT_API_KEY=
AGENT_TIMEOUT=120

# The model the example agent forwards each question to.
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Azure OpenAI, used instead of OPENAI_* when the key, endpoint, and
# deployment name are all set. AZURE_OPENAI_API_VERSION is the date
# Azure expects, such as 2024-10-21.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Server configuration
HOST=127.0.0.1
PORT=8080
